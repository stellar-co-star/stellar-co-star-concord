{
  "name": "stellar-co-star-stellar-co-star-stellar-co-star-concord",
  "private": true,
  "license": "MIT",
  "description": "Reconciliation between tokenized securities on Stellar and the official register.",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.22.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm build && pnpm --filter @stellar-co-star-stellar-co-star-stellar-co-star-concord/web e2e",
    "dev": "pnpm --parallel --filter @stellar-co-star-stellar-co-star-stellar-co-star-concord/api --filter @stellar-co-star-stellar-co-star-stellar-co-star-concord/web dev",
    "start": "pnpm --filter @stellar-co-star-stellar-co-star-stellar-co-star-concord/api start",
    "stellar-co-star-stellar-co-star-stellar-co-star-concord": "pnpm --silent --filter @stellar-co-star-stellar-co-star-stellar-co-star-concord/api cli",
    "demo:testnet": "pnpm --filter @stellar-co-star-stellar-co-star-stellar-co-star-concord/api demo:testnet"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
